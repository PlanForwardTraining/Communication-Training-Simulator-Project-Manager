# ============================================================
# Communication Training Simulator — Environment Variables
# ============================================================
# This is a TEMPLATE. Copy it to `.env` and fill in real values.
# The `.env` file is gitignored and will never be committed.
#
# When the server/ folder is created during Phase 1, these
# variables move to `server/.env` (same names, same values).
# ============================================================


# ----- AI Service Keys (required) -----
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
OPENAI_API_KEY=sk-PLACEHOLDER
ELEVENLABS_API_KEY=PLACEHOLDER
ELEVENLABS_VOICE_ID=PLACEHOLDER


# ----- Authentication -----
# Generate a strong random string with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-96-char-random-hex
JWT_EXPIRES_IN=7d


# ----- Database & Storage Paths -----
DATABASE_PATH=./data/simulator.db
EXCEL_PATH=./data/sessions.xlsx
AUDIO_DIR=./data/audio


# ----- Email (optional, for password resets) -----
RESEND_API_KEY=re_PLACEHOLDER
RESEND_FROM_EMAIL=noreply@your-company.com


# ----- Server Configuration -----
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
